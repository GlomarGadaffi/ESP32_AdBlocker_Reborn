# T-ETH-Elite (ESP32-S3 + W5500 + OPI PSRAM)

# PSRAM — OPI at 40MHz (matches LilyGO example; 80MHz marginal through GPIO matrix)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_MEMTEST=y

# W5500 SPI Ethernet
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# lwIP — raise socket ceiling; DNS server + upstream + httpd + download all need sockets simultaneously.
# 24 (was 16): the old budget stopped closing once TCP/53 (+2, #66) and the
# persistent-DoT worker (+1, #5/C2) landed — httpd ~9 + DNS 2 + TCP 2 + DoT 1
# + SNTP + mDNS left zero slack. Each socket costs a few hundred bytes of
# internal RAM; httpd's own max_open_sockets guard (#61) is a separate knob
# and stays at 7.
CONFIG_LWIP_MAX_SOCKETS=24
# Mailbox depth: under bursty concurrent load, queries drop here before dns_task
# drains them. Raise UDP per-socket + the driver->tcpip_thread mailbox.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144
# Pin tcpip_thread to Core 0 so it runs parallel to dns_task (Core 1), not
# contending on the same core. The per-query cost is mostly waiting on this
# thread, so separating them should overlap work and raise throughput.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Core locking: let the calling task run lwIP directly under a lock instead of
# message-passing every socket call to tcpip_thread. Measured: blocked sendto()
# is ~2ms (the entire query cost) — almost all of it the tcpip_thread round-trip.
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
# Enable SO_RCVBUF so setsockopt(SO_RCVBUF) actually resizes the socket's
# receive window; without this the call silently does nothing in lwIP.
CONFIG_LWIP_SO_RCVBUF=y
# SNTP: allow 2 servers (NIST primary + NTP pool fallback) for wall-clock time.
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# System
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
# Full CPU clock (default was leaving it at 160MHz) — helps the lwIP forward/cache path.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Pull lwIP's hot path into IRAM so a flash-cache miss never stalls UDP/IP — biggest
# p99-tail win on the forwarded/cached (lwIP) path. Costs IRAM; back out if build overflows.
CONFIG_LWIP_IRAM_OPTIMIZATION=y

# Partition table — dual OTA slots (#1: browser-driven firmware update, matching
# upstream ESP32_AdBlocker's OTA Upload tab). ota_0/ota_1 at 1700K each easily
# clears the current ~1.15MB binary with headroom; nvs/otadata/phy_init total
# under 40KB, so this still uses well under 4MB of the board's 16MB flash.
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y
# Auto-revert to the previous slot if a new image never confirms itself valid
# (crash-loops, or dns_task/web UI never come up) — the load-bearing safety net
# for OTA on a device with no local recovery display. app_main calls
# esp_ota_mark_app_valid_cancel_rollback() once the DNS server and web UI are
# both confirmed running; anything short of that self-reverts on next boot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ── Release performance + size ───────────────────────────────────────
# Ship a real release build, not the IDF default -Og debug build.
# -O2 for speed; assertions off (defines NDEBUG) drops all the assert strings
# (size) and their runtime checks (speed) — the main size lever here.
# (IDF 6.0.1 has no clean kconfig for LTO; per-component -flto would hurt
#  maintainability, so it's intentionally not used.)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
# Bigger instruction cache cuts flash misses on the DNS task (runs from flash;
# only lwIP is in IRAM).
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# NOTE: flash MUST stay DIO. This module (ESP32-S3-WROOM-1 N16R8) has 8MB OCTAL
# (OPI) PSRAM, and octal PSRAM contends with QIO flash on the S3 MSPI controller
# — QIO causes a TG0WDT watchdog boot-loop on this board. DIO@80MHz is the
# hardware ceiling here. Confirmed empirically + in LilyGO's own examples.

# ── TLS certificate validity dates (#75) ─────────────────────────────
# OFF BY DEFAULT IN ESP-IDF, and that is not a size trade — it is a silent
# security hole. With MBEDTLS_HAVE_TIME_DATE unset, mbedtls_x509_time_is_past()
# and _is_future() are compiled as "return 0" (see mbedtls/library/x509.c), so
# notBefore/notAfter are never read: an EXPIRED certificate verifies fine,
# forever. The blocklist fetch and DoT both ride the cert bundle, so both were
# affected.
#
# This REQUIRES the #75 clock floor to be in place first: date checking against
# a clock reading 1970 makes every certificate not-yet-valid and breaks every
# boot-time TLS handshake. timesync_floor_init() runs before the network does.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
#
# ...and turning it on REQUIRES turning the cross-signed bundle path off. These
# two IDF options are mutually exclusive in practice, which is not documented
# anywhere and cost a full afternoon to find, so the mechanism is recorded here:
#
# With CROSS_SIGNED_VERIFY set, esp_crt_bundle installs esp_crt_ca_cb_callback
# as mbedTLS's CA callback. That callback SYNTHESISES a trust anchor from the
# bundle (esp_crt_bundle.c) and fills in only ca_istrue, version, subject_raw
# and the public key - valid_from and valid_to are left as calloc() left them,
# all zeroes. Zero dates read as 0000-00-00, so the moment date checking is on,
# mbedtls_x509_time_is_past() flags the anchor MBEDTLS_X509_BADCERT_EXPIRED.
# esp_crt_verify_callback then bails, because it only rescues a certificate
# whose ONLY complaint is BADCERT_NOT_TRUSTED. Result: every handshake dies
# with -0x2700 (X509_CERT_VERIFY_FAILED) no matter how correct the clock or the
# server's chain. Measured: big.oisd.nl, a perfectly valid Let's Encrypt chain,
# rejected outright; with the callback off, the same fetch pulls 266422
# domains.
#
# What is lost: path-building around a chain that ends in an EXPIRED
# cross-signed root (the DST Root CA X3 situation of 2021). That is a real, if
# narrow, cost. It is worth it, because with dates unchecked the cross-signed
# feature has nothing to do anyway - an expired cross-sign is invisible to a
# build that never looks at dates. The two options only ever mattered together,
# and together they do not work.
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY is not set

# ── TLS buffers out of internal RAM ──────────────────────────────────
# Measured on this board: heap_free 35.8 KB but heap_largest only 15.4 KB,
# while mbedtls_ssl_setup() needs ONE contiguous ~16.5 KB in_buf
# (MBEDTLS_SSL_IN_CONTENT_LEN 16384 + record overhead). Every HTTPS fetch was
# dying at setup with -0x008D (PSA_ERROR_INSUFFICIENT_MEMORY) -- reproduced
# identically on 82af675, so this predates the clock work and was masked only
# because the box boots its blocklist from the SD cache.
#
# Sent to PSRAM rather than shrinking IN_CONTENT_LEN: a smaller input buffer
# guesses at the largest TLS record a server will ever send (nginx defaults to
# 16 KB), and guessing wrong fails the handshake. This board has 1.45 MB of
# PSRAM idle. TLS is not on the DNS query path unless DoT is on, and DoT holds
# one persistent session, so the slower memory costs a handshake, not a query.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
