# ESP-IDF build output (fully regenerated by `idf.py build`)
/build/
/build-waveshare/
/build-wifi/

# Generated sdkconfig — source of truth is sdkconfig.defaults
# (plus the sdkconfig.board.* overlay for non-default boards; the generated
#  per-board sdkconfig.waveshare also carries Wi-Fi credentials — keep it out)
/sdkconfig
/sdkconfig.old
/sdkconfig.waveshare
/sdkconfig.waveshare.old
/sdkconfig.wifi
/sdkconfig.wifi.old

# IDF Component Manager output (regenerated from main/idf_component.yml + dependencies.lock)
/managed_components/

# OTA signing key — private, never commit (see sdkconfig.defaults "Signed OTA images")
/secure_boot_signing_key.pem
*.pem

# Fuzz build output + crash reproducers live next to the harness
/tests/fuzz/out/
/tests/fuzz/crashes/

# Editor / OS cruft
*.swp
.DS_Store
/release/

# Serial monitor scratch output
monitor_live.log

# Python cruft (tools/board_client)
__pycache__/
*.pyc

# local agent workflow scripts
/.claude/workflows/
/.claude/worktrees/
